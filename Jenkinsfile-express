pipeline {
    agent any
    stages {
        stage('Checkout Code') {
            steps {
                git branch: 'master', url: 'https://github.com/vamsi462/docker-assignment-node-express-flask'
            }
        }
        stage('Install Dependencies') {
            steps {
                dir('frontend') {
                    sh 'npm install'
                }
            }
        }
        stage('Restart Application') {
            steps {
                dir('frontend') {
                    sh 'pm2 restart express-frontend || pm2 start server.js --name "express-frontend"'
                }
            }
        }
    }
}